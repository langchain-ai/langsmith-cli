{
  "rules": [
    {
      "name": "openai",
      "match_hosts": ["api.openai.com"],
      "match_paths": [],
      "headers": [
        {"name": "Authorization", "type": "opaque", "value": "Bearer sk-test"}
      ],
      "enabled": true
    },
    {
      "name": "attribution",
      "type": "attribution",
      "headers": [{"name": "X-Cost-Center", "type": "plaintext", "value": "engineering"}],
      "enabled": true
    }
  ],
  "access_control": {
    "allow_list": ["*.openai.com"]
  }
}
